# Server Port
PORT=5050

# MongoDB Connection String (Atlas Cloud or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.eetzxhw.mongodb.net/edubase?retryWrites=true&w=majority

# JWT Security Secret Keys
JWT_SECRET=supersecretkey123
JWT_REFRESH_SECRET=supersecretrefreshkey456

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
